NEXT_PUBLIC_AXIOM_GITHUB_URL=https://github.com/your-org/axiom
NEXT_PUBLIC_AXIOM_DATA_MODE=http
NEXT_PUBLIC_AXIOM_API_URL=http://127.0.0.1:4000

# Backend
DATABASE_URL=postgresql://axiom:axiom@localhost:5432/axiom
API_HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Semantic indexing. Use openai normally; fake is an explicit local/demo fallback.
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
