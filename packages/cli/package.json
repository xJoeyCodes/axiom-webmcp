{
  "name": "@axiom-webmcp/cli",
  "version": "0.1.0",
  "description": "Inspect, publish, and test Axiom capability manifests.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "axiom": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@axiom-webmcp/client": "0.1.0",
    "@axiom-webmcp/sdk": "0.1.0",
    "commander": "^14.0.2"
  }
}
